{
  "name": "foxsocket",
  "version": "0.7.0-alpha.1",
  "description": "Rennie personal AI desktop workspace — your agent, your models, your devices",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "author": "Applied AI Solutions",
  "main": "src/main.js",
  "scripts": {
    "dev": "node build/build-ui.mjs && electron . --rennie-dev",
    "dev:fresh": "node build/build-ui.mjs && electron . --rennie-dev --fresh",
    "dist:dev": "node build/dev-build.cjs",
    "start": "node build/build-ui.mjs && electron .",
    "package": "node build/build-ui.mjs && electron-builder --config electron-builder.cjs --win dir",
    "dist": "node build/build-ui.mjs && node build/render-maker.cjs && electron-builder --config electron-builder.cjs --win nsis",
    "build:ui": "node build/build-ui.mjs",
    "test": "node --test \"test/unit/*.test.cjs\"",
    "test:ui": "node build/build-ui.mjs && electron test/smoke/workspace-smoke.cjs",
    "test:setup": "node --test test/unit/setup.test.cjs && powershell -NoProfile -ExecutionPolicy Bypass -File test/unit/host-setup.test.ps1",
    "render:maker": "node build/render-maker.cjs",
    "test:updates": "node --test test/unit/updates.test.cjs",
    "test:host": "node --test test/unit/host-manager.test.cjs"
  },
  "devDependencies": {
    "@awesome.me/webawesome": "^3.12.0",
    "animejs": "^4.5.0",
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "motion": "^13.2.0",
    "sharp": "^0.35.4"
  },
  "build": {
    "appId": "solutions.appliedai.commandcenter",
    "productName": "Rennie",
    "files": [
      "LICENSE",
      "THIRD-PARTY-NOTICES.md",
      "src/**/*",
      "!src/ui-effects.js",
      "!src/dev-main.cjs",
      "docs/fresh-pc-setup.md",
      "build/host-startup.ps1"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Rennie-Setup-${version}.${ext}",
      "forceCodeSigning": true,
      "signExts": [
        ".exe",
        ".dll",
        ".node",
        ".ps1"
      ],
      "icon": "src/assets/icon.ico",
      "executableName": "Rennie"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "shortcutName": "Rennie",
      "runAfterFinish": true
    },
    "directories": {
      "output": "release"
    }
  }
}
